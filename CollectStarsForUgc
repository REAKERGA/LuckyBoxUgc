task.wait(5)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local TeleportService = game:GetService("TeleportService")

local GAME_ID = 101497717358165
local INITIAL_POSITION = Vector3.new(-100, 3, 28)
local TELEPORT_DELAY = 0.1
local HEIGHT_OFFSET = 3
local TWEEN_DURATION = 1 -- seconds for initial movement
local player = Players.LocalPlayer

local function smoothTween(part, targetCF, duration)
    local tweenInfo = TweenInfo.new(
        duration,
        Enum.EasingStyle.Quad,
        Enum.EasingDirection.Out
    )
    local tween = TweenService:Create(part, tweenInfo, {CFrame = targetCF})
    tween:Play()
    return tween
end

local function teleportThroughParts()
    local character = player.Character or player.CharacterAdded:Wait()
    local rootPart = character:WaitForChild("HumanoidRootPart")
    
    -- First: Tween to initial position
    local initialTween = smoothTween(rootPart, CFrame.new(INITIAL_POSITION), TWEEN_DURATION)
    initialTween.Completed:Wait()
    
    local pointParts = workspace:FindFirstChild("TowerObby") and workspace.TowerObby:FindFirstChild("PointParts")
    if not pointParts then
        warn("PointParts folder not found!")
        return false
    end
    
    -- Collect all parts
    local parts = {}
    for _, child in ipairs(pointParts:GetChildren()) do
        if child:IsA("BasePart") then
            table.insert(parts, child)
        end
    end
    
    -- Teleport to each part
    for _, part in ipairs(parts) do
        if not character or not character.Parent then break end
        
        rootPart.CFrame = part.CFrame + Vector3.new(0, HEIGHT_OFFSET, 0)
        
        local start = os.clock()
        while os.clock() - start < TELEPORT_DELAY do
            RunService.Heartbeat:Wait()
        end
    end
    
    return true
end

local function rejoinGame()
    TeleportService:Teleport(GAME_ID, player)
end

local function main()
    local success, result = pcall(teleportThroughParts)
    
    if success and result then
        print("Completed all parts - rejoining game...")
        rejoinGame()
    else
        warn("Process interrupted:", result)
    end
end

-- Run on character spawn
player.CharacterAdded:Connect(function()
    wait(1) -- Ensure character is fully loaded
    main()
end)

-- Run immediately if already in game
if player.Character then
    main()
end
